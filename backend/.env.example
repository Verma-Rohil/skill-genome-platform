# ============================================================
# Skill Genome Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skill_genome
DB_USER=root
DB_PASSWORD=your_password_here

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Embedding ---
EMBEDDING_MODEL=word2vec          # word2vec | sbert
EMBEDDING_DIM=100
EMBEDDING_WINDOW=5
EMBEDDING_MIN_COUNT=3

# --- Clustering ---
CLUSTER_METHOD=kmeans              # kmeans | hdbscan
CLUSTER_N=8                        # Number of archetypes (kmeans only)
